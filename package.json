{
  "name": "zuvcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "release:build": "pnpm build && node scripts/build-release.mjs",
    "setup": "pnpm build && node scripts/install-cli.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm build && node apps/cli/dist/index.js",
    "doctor": "pnpm build && node apps/cli/dist/index.js doctor",
    "zuvcode": "pnpm build && node apps/cli/dist/index.js",
    "test": "vitest run tests --pool=threads --isolate=false",
    "test:terminal": "pnpm build && node scripts/verify-terminal.mjs",
    "typecheck": "tsc -b tsconfig.build.json --pretty false"
  },
  "devDependencies": {
    "@inquirer/testing": "^3.3.12",
    "@types/node": "^24.10.1",
    "@vercel/ncc": "0.45.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@zuvcode/core": "workspace:*",
    "@zuvcode/model-router": "workspace:*",
    "@zuvcode/orchestration": "workspace:*",
    "@zuvcode/permissions": "workspace:*",
    "@zuvcode/persistence": "workspace:*",
    "@zuvcode/shared": "workspace:*",
    "@zuvcode/terminal-ui": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "zod": "^4.1.13"
  }
}
